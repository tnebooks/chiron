# GitHub personal access token for the bot/team account used to raise PRs
# against tnebooks org repos. Needs `repo` scope and direct push access
# (no forking) to the target repos.
GITHUB_TOKEN=

# Local Ollama server used for the English->Tamil translation draft.
OLLAMA_HOST=http://localhost:11434

# Ollama model used for translation. Quality is a human-review problem, not
# something to over-tune here -- swap anytime with `ollama pull <model>`.
PDF2MD_OLLAMA_MODEL=llama3.1
